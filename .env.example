# URL da Evolution API (você sobe 1x grátis no Render/Railway)
# Ex: https://sua-evolution.onrender.com
EVOLUTION_API_URL=
EVOLUTION_APIKEY=
EVOLUTION_INSTANCE=promocoes

# IDs dos grupos (JID). Ex: 1203630xxxx@g.us,1203630yyyy@g.us
# Pegue com: python3 conectar.py grupos
TARGET_GROUPS=

# Shopee Affiliate Open API — só em variável de ambiente, NUNCA commitar
SHOPEE_AFFILIATE_ID=
SHOPEE_APPID=
SHOPEE_SECRET=
# Opcional: keywords extras (vírgula). Ex: SHOPEE_SEARCHES=celular,notebook,sofa
SHOPEE_SEARCHES=

# TikTok Shop Partner Center (Affiliate app) — NUNCA colar valores reais no repo
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
# Token da loja/criador que autorizou o app (gere 1x no Partner Center)
TIKTOK_ACCESS_TOKEN=
# Opcional (alguns endpoints pedem) + keywords extras
TIKTOK_SHOP_CIPHER=
TIKTOK_SEARCHES=
TIKTOK_ENABLED=True

# Via SEM CNPJ p/ buscas automáticas TikTok+Shopee (aceita CPF, grátis)
# Painel Ecomobi -> API/Token
ECOMOBI_API_KEY=
ECOMOBI_ENABLED=True

# Intervalo entre varreduras (minutos)
SCAN_INTERVAL_MIN=10
# Máx ofertas por varredura
MAX_OFFERS_PER_SCAN=2
# Desconto mínimo % para postar (evita lixo)
MIN_DISCOUNT_PCT=20

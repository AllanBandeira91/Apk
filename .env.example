# URL da Evolution API (você sobe 1x grátis no Render/Railway)
# Ex: https://sua-evolution.onrender.com
EVOLUTION_API_URL=
EVOLUTION_APIKEY=
EVOLUTION_INSTANCE=promocoes

# IDs dos grupos (JID). Ex: 1203630xxxx@g.us,1203630yyyy@g.us
# Pegue no painel /grupos depois de conectar
TARGET_GROUPS=

# Afiliados (cole os seus; se vazio, manda link puro)
ML_AFFILIATE_TAG=
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=  # gerado 1x via /callback (bot renova sozinho depois)
ML_GROUPS=  # JID do grupo ML, ex: 1203630xxx@g.us
SHOPEE_AFFILIATE_ID=
SHOPEE_APPID=
SHOPEE_SECRET=  # Affiliate Open API — só em variável de ambiente, NUNCA commitar
AMAZON_TAG=
ALIEXPRESS_AFF_ID=

# Intervalo entre varreduras (minutos)
SCAN_INTERVAL_MIN=120
# Máx ofertas por varredura
MAX_OFFERS_PER_SCAN=6
# Desconto mínimo % para postar (evita lixo)
MIN_DISCOUNT_PCT=20
